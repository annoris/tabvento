# Copy this file to .env. The Tabvento server loads environment variables on startup.
# Never enter API keys in browser forms and never commit your .env file to GitHub.

# Disable runtime telemetry by default.
ANONYMIZED_TELEMETRY=false
BH_TELEMETRY=0

# Configure only the AI model provider you select for Live Browser Mode:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=             # Optional OpenAI-compatible endpoint
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=              # Alternative for Google Gemini
# TABVENTO_COMPATIBLE_API_KEY= # Remote OpenAI-compatible server
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# OPENAI_API_VERSION=

# Optional: custom directory for local SQLite database and mission workspaces.
# TABVENTO_DATA_DIR=

# Optional: Solana RPC URL for verifying contributions (defaults to https://api.mainnet-beta.solana.com).
# Official Solana Wallet (minimum $88 USD, no maximum limit): 3HvUMCUSSHEdtA35UuD4J7mbgpTxJ7LgT2X7GfdzvBdm
# TABVENTO_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Runtime logging level: debug, info, warning, error.
# BROWSER_USE_LOGGING_LEVEL=info
